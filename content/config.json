                "label": "UGC Item",
                "value": "ugc"
              },
              {
                "label": "Time-Limited",
                "value": "time-limited"
              },
              {
                "label": "Perpetual",
                "value": "perpetual"
              }
            ],
            "dependsOn": {
              "field": "entry_category",
              "disabledWhenEmpty": true,
              "optionsWhen": {
                "new_item": ["ugc"],
                "game_integration": ["time-limited", "perpetual"],
                "full_game": ["time-limited", "perpetual"]
              }
            }
          },
          {
            "name": "creator_id",
            "type": "text",
            "label": "CREATOR ID",
            "placeholder": "e.g. 123456789",
            "required": true,
            "errorMessage": "Please enter your Creator ID",
            "validate": {
              "pattern": "[0-9]{9}",
              "message": "Creator ID must be 9 digits, numbers only",
              "inputMode": "numeric",
              "maxLength": 9
            }
          },
          {
            "name": "experience_id_url",
            "type": "text",
            "label": "EXPERIENCE URL",
            "placeholder": "https://",
            "required": true,
            "errorMessage": "Please enter a valid Experience URL",
            "validate": {
              "pattern": "https?://(?!www\\.[a-z0-9-]+(?:[:/?#]|$))(?!(?:[0-9]+\\.){2,}[a-z]{2,63}(?:[:/?#]|$))(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}(?::[0-9]{1,5})?(?:[/?#]\\S*)?",
              "message": "Please enter a valid URL, starting with https://",
              "inputMode": "url"
            },
            "dependsOn": {
              "field": "entry_category",
              "textWhen": {
                "new_item": {
                  "label": "UGC ITEM URL",
                  "errorMessage": "Please enter a valid UGC Item URL"
                },
                "game_integration": {
                  "label": "GAME URL",
                  "errorMessage": "Please enter a valid Game URL"
                },
                "full_game": {
                  "label": "GAME URL",
                  "errorMessage": "Please enter a valid Game URL"
                }
              }
            }
          },
